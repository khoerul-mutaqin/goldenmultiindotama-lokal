# To return an action, assign: action = {...}
self = records
for rec in self:
    if rec.origin:
        origins_list = [x.strip() for x in rec.origin.split(',')]
        rec['x_studio_split_transfer_tags'] = self.env['stock.picking'].search([('name', 'in', origins_list)])
    else:
        rec['x_studio_split_transfer_tags'] = False



